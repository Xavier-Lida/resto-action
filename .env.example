# L'AGENDA. Aucune de ces valeurs n'est publique : elles vont dans .env.local
# en développement et dans le tableau de bord Vercel en production.
#
# Mise en place, côté Google, une fois pour toutes :
#   1. Google Cloud → nouveau projet → activer « Google Calendar API ».
#   2. Créer un compte de service, générer une clé JSON.
#   3. Console d'admin Workspace → Sécurité → Contrôles des API → Délégation à
#      l'échelle du domaine → ajouter l'ID client du compte de service avec la
#      portées https://www.googleapis.com/auth/calendar,https://www.googleapis.com/auth/gmail.send
#      (calendar : sans elle, pas d'événement. gmail.send : sans elle, le resto
#      fondateur ne reçoit ni le courriel de bienvenue avec le lien de son
#      dossier, ni les courriels d'avancement. Voir src/lib/google/courriel.ts.)
#   4. Créer le calendrier secondaire « Resto Action — Disponibilités » et
#      relever son ID dans ses paramètres.

# Le champ client_email de la clé JSON.
GOOGLE_SA_COURRIEL=
# Le champ private_key de la clé JSON, sur une seule ligne, \n compris.
GOOGLE_SA_CLE=
# L'identité empruntée : le propriétaire des rendez-vous.
GOOGLE_SUJET=guillaume@studioslt.com

# Le calendrier qui DÉFINIT les plages offertes. Ajouter ou retirer une
# disponibilité s'y fait à la main, dans Google Calendar, sans redéployer.
GOOGLE_CAL_DISPO=
# Les calendriers qui RETRANCHENT : tout ce qui y occupe Guillaume ferme le
# créneau correspondant. Séparés par des virgules.
GOOGLE_CAL_OCCUPE=primary
# Où atterrit le rendez-vous créé.
GOOGLE_CAL_RDV=primary

# LE TABLEAU DE BORD (/tableau). Mot de passe HTTP « Basic » vérifié par
# src/proxy.ts ; l'utilisateur est ignoré, seul le mot de passe compte. Sans
# cette variable la page répond 401 à tout le monde : la poser en Production
# ET en Preview dans Vercel, sinon les aperçus resteront fermés.
TABLEAU_MDP=

# ─── Le CRM (dashboard.restoaction.ca) ───
# Chaque réservation lui est annoncée après coup (src/lib/crm.ts). À poser en
# PRODUCTION SEULEMENT : sans ces deux variables, le site ne prévient personne —
# c'est ce qu'on veut d'un aperçu Vercel ou d'un poste de développement, qui ne
# doivent pas écrire de prospects dans le vrai CRM.
# Le secret est le même que CRM_INGESTION_SECRET côté CRM.
CRM_INGESTION_URL=https://dashboard.restoaction.ca/api/ingestion/reservation
CRM_INGESTION_SECRET=

# ─── Stripe : la réservation fondateur (/reserver) ───
# Voir src/lib/stripe.ts. Les clés « test » (sk_test_…) permettent d'essayer
# avec la carte 4242 4242 4242 4242 sans encaisser.
# Stripe → Développeurs → Clés API → Clé secrète.
STRIPE_CLE_SECRETE=
# Stripe → Développeurs → Webhooks → ajouter un point de terminaison :
#   https://www.restoaction.ca/api/stripe/webhook, événements
#   checkout.session.completed ET customer.updated (le second envoie au resto un
#   courriel quand on fait avancer son dossier dans les métadonnées du client)
# puis copier son secret de signature (whsec_…).
STRIPE_WEBHOOK_SECRET=
# Stripe → Catalogue de produits → Taux de taxe : créer « TPS » 5 % et
# « TVQ » 9,975 %, non inclus dans le prix, Canada / Québec. Copier les ID txr_….
STRIPE_TAXE_TPS=
STRIPE_TAXE_TVQ=
# L'adresse du CRM qui reçoit les restos fondateurs (prospects et paiements).
# Vide tant que la route n'existe pas côté CRM : rien n'est envoyé.
CRM_FONDATEUR_URL=

# ─── Réfère un resto (src/lib/references/envoi.ts) ───
# L'adresse du CRM qui reçoit les événements du programme. Vide en mode pilote :
# tout part alors par courriel à REFERENCES_COURRIEL_EQUIPE.
CRM_REFERENCES_URL=
# La boîte de l'équipe qui reçoit les références en mode pilote (et en secours
# si le CRM ne répond pas). À poser dans Vercel, jamais écrite dans le code.
REFERENCES_COURRIEL_EQUIPE=

# ─── La porte unique des leads (src/lib/leads/envoi.ts) ───
# Tous les formulaires où un resto laisse un contact passent par signalerLead :
# la base (Supabase), puis l'alerte « [Lead] … » par courriel.
#
# La boîte de l'équipe qui reçoit l'alerte pour CHAQUE lead, que la base ait
# répondu ou non. À poser dans Vercel (et dans .env.local pour essayer), jamais
# écrite dans le code. Tant qu'elle manque, les alertes vont à
# REFERENCES_COURRIEL_EQUIPE (pour une référence), sinon à GOOGLE_SUJET.
LEADS_COURRIEL_EQUIPE=

# ─── La base des leads : Supabase (src/lib/leads/base.ts, supabase/schema.sql) ───
# Supabase → le projet → Project Settings → Data API : « Project URL ».
SUPABASE_URL=
# Supabase → le projet → Project Settings → API Keys : la clé SECRÈTE
# (sb_secret_…). JAMAIS la clé « publishable », et jamais avec le préfixe
# NEXT_PUBLIC_ : elle ne doit pas aller au navigateur. Sans ces 2 variables,
# aucun lead n'est rangé : l'alerte part quand même, avec la mention « Pas
# enregistré dans le CRM ».
SUPABASE_CLE_SECRETE=

# ─── Google Places : l'aperçu automatique de « Trouve ton resto » ───
# Voir src/lib/places.ts. Google Cloud → API et services → activer « Places API
# (New) » → Identifiants → Créer une clé API, restreinte à « Places API (New) ».
# Quelques cents par recherche. Sans cette clé, la fenêtre montre l'exemple de
# Bistro Habibi à la place de l'aperçu.
GOOGLE_PLACES_CLE=

# Local seulement : simule une date pour tester la fin du 750 $ (ignorée en production).
# SIMULER_DATE=2026-12-19

# ─── Le Studio Photo (/studio, src/lib/studio/) ───
# La page reste cachée tant que STUDIO_ACTIF est à faux dans src/lib/site.ts
# (elle ne répond que sur un poste de développement). Aucune de ces clés ne va
# au navigateur.
#
# La retouche par IA : Google AI Studio (aistudio.google.com) → Get API key,
# avec la facturation activée (les modèles d'image n'ont pas de palier gratuit).
# Sans cette clé, on livre la correction sans génération.
GEMINI_API_KEY=
# Les 2 contrôles et la publication : la même clé que la lecture du relevé
# (src/app/api/releve/route.ts). Sans elle, le Studio ne répond pas.
ANTHROPIC_API_KEY=
# Le magasin PRIVÉ des photos : Vercel → Storage → Create → Blob → accès
# « Private », relié au projet. Copier son jeton (BLOB_READ_WRITE_TOKEN). Les
# photos s'y effacent toutes seules après STUDIO.gardeJours. Sans lui, le Studio
# ne répond pas.
BLOB_READ_WRITE_TOKEN=
# /studio/suivi (les dernières retouches) s'ouvre avec TABLEAU_MDP, plus haut.
# Local seulement : vérifier la tuyauterie du Studio AVANT d'avoir les clés d'IA
# (ignorée en ligne). Aucun contrôle n'est fait et c'est la correction sans
# génération qui est livrée : ce n'est pas un test de la retouche. À retirer dès
# que GEMINI_API_KEY et ANTHROPIC_API_KEY sont là.
# STUDIO_ESSAI_SANS_IA=1

# ─── Le courriel sans compte de service (23 nov. 2026) ───
# Une adresse Gmail et son « mot de passe d'application » (myaccount.google.com →
# Sécurité → Validation en 2 étapes → Mots de passe des applications). Si les 2
# sont posées, TOUS les courriels du site partent par ce compte (smtp.gmail.com),
# et le compte de service GOOGLE_SA_* ne sert plus qu'à l'agenda.
COURRIEL_SMTP_UTILISATEUR=
COURRIEL_SMTP_MDP=
