# L'AGENDA. Aucune de ces valeurs n'est publique : elles vont dans .env.local
# en développement et dans le tableau de bord Vercel en production.
#
# Mise en place, côté Google, une fois pour toutes :
#   1. Google Cloud → nouveau projet → activer « Google Calendar API ».
#   2. Créer un compte de service, générer une clé JSON.
#   3. Console d'admin Workspace → Sécurité → Contrôles des API → Délégation à
#      l'échelle du domaine → ajouter l'ID client du compte de service avec la
#      portée https://www.googleapis.com/auth/calendar
#      (sans ça : pas de lien Meet, pas d'invitation, pas d'événement.)
#   4. Créer le calendrier secondaire « Resto Action — Disponibilités » et
#      relever son ID dans ses paramètres.

# Le champ client_email de la clé JSON.
GOOGLE_SA_COURRIEL=
# Le champ private_key de la clé JSON, sur une seule ligne, \n compris.
GOOGLE_SA_CLE=
# L'identité empruntée : le propriétaire des rendez-vous.
GOOGLE_SUJET=guillaume@studioslt.com

# Le calendrier qui DÉFINIT les plages offertes. Ajouter ou retirer une
# disponibilité s'y fait à la main, dans Google Calendar, sans redéployer.
GOOGLE_CAL_DISPO=
# Les calendriers qui RETRANCHENT : tout ce qui y occupe Guillaume ferme le
# créneau correspondant. Séparés par des virgules.
GOOGLE_CAL_OCCUPE=primary
# Où atterrit le rendez-vous créé.
GOOGLE_CAL_RDV=primary

# LE TABLEAU DE BORD (/tableau). Mot de passe HTTP « Basic » vérifié par
# src/proxy.ts ; l'utilisateur est ignoré, seul le mot de passe compte. Sans
# cette variable la page répond 401 à tout le monde : la poser en Production
# ET en Preview dans Vercel, sinon les aperçus resteront fermés.
TABLEAU_MDP=

# ─── Le CRM (dashboard.restoaction.ca) ───
# Chaque réservation lui est annoncée après coup (src/lib/crm.ts). À poser en
# PRODUCTION SEULEMENT : sans ces deux variables, le site ne prévient personne —
# c'est ce qu'on veut d'un aperçu Vercel ou d'un poste de développement, qui ne
# doivent pas écrire de prospects dans le vrai CRM.
# Le secret est le même que CRM_INGESTION_SECRET côté CRM.
CRM_INGESTION_URL=https://dashboard.restoaction.ca/api/ingestion/reservation
CRM_INGESTION_SECRET=

# ─── Stripe : la réservation fondateur (/reserver) ───
# Voir src/lib/stripe.ts. Les clés « test » (sk_test_…) permettent d'essayer
# avec la carte 4242 4242 4242 4242 sans encaisser.
# Stripe → Développeurs → Clés API → Clé secrète.
STRIPE_CLE_SECRETE=
# Stripe → Développeurs → Webhooks → ajouter un point de terminaison :
#   https://www.restoaction.ca/api/stripe/webhook, événement checkout.session.completed
# puis copier son secret de signature (whsec_…).
STRIPE_WEBHOOK_SECRET=
# Stripe → Catalogue de produits → Taux de taxe : créer « TPS » 5 % et
# « TVQ » 9,975 %, non inclus dans le prix, Canada / Québec. Copier les ID txr_….
STRIPE_TAXE_TPS=
STRIPE_TAXE_TVQ=
# L'adresse du CRM qui reçoit les restos fondateurs (prospects et paiements).
# Vide tant que la route n'existe pas côté CRM : rien n'est envoyé.
CRM_FONDATEUR_URL=
